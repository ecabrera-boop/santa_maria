# Django / dashboard
DEBUG=true
SECRET_KEY=change-me-in-production

# Optional: Google Maps JavaScript API key for the incident map.
# Leave blank to use the free OpenStreetMap (Leaflet) fallback.
# Free demo key (no credit card): https://mapsplatform.google.com/maps-demo-key/
# Or create a key: https://developers.google.com/maps/documentation/javascript/get-api-key
GOOGLE_MAPS_API_KEY=

# Map default center — Santa Maria, Ilocos Sur
EIC_MAP_CENTER_LAT=17.3665
EIC_MAP_CENTER_LNG=120.4818
EIC_MAP_DEFAULT_ZOOM=13
